flowchart TB
    UI["Покупатель / веб-интерфейс"]
    subgraph LOCAL["Kubernetes / Minikube: namespace rewear — или Docker Compose"]
        GW["Nginx gateway — маршрутизация и интерфейс"]
        C["Catalog — товары, цены, уникальные остатки"]
        A["Cart — выбранные вещи без резерва"]
        O["Order — оркестратор саги; заказы, тестовая оплата, outbox"]
        N["Notification — уведомления; ACK после commit, UQ event_id"]
        CD[("catalog_db / PostgreSQL")]
        AD[("cart_db / PostgreSQL")]
        OD[("order_db / PostgreSQL")]
        ND[("notification_db / PostgreSQL")]
        R[("Redis / кеш Catalog<br/>Описания, цены для показа, результаты фильтрации<br/>TTL 60 с; наличие и резерв — PostgreSQL<br/>При отказе Redis — чтение PostgreSQL")]
        subgraph BROKER["RabbitMQ"]
            EX["Exchange: orders.events"]
            Q["Queue: notifications.orders"]
            EX -.->|"bindings: order.confirmed / order.cancelled"| Q
        end
        GW -->|"HTTP: каталог"| C
        GW -->|"HTTP: корзина"| A
        GW -->|"HTTP: заказ"| O
        GW -->|"HTTP: уведомления"| N
        A -->|"HTTP: batch products"| C
        O -->|"HTTP: reserve / read / complete / release"| C
        O -->|"HTTP: cart / remove-items"| A
        C -->|"RESP: cache-aside"| R
        C -->|SQL| CD
        A -->|SQL| AD
        O -->|SQL| OD
        N -->|SQL| ND
        O -.->|"AMQP: OrderConfirmed / OrderCancelled"| EX
        Q -.->|"AMQP: итог заказа"| N
    end
    UI -->|"HTTP: локальный gateway"| GW
