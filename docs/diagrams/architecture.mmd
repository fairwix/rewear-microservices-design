flowchart TB
    UI["Браузер customer/admin: главная, страницы, пресеты, корзина"]
    subgraph LOCAL["Локально: Compose / Minikube; 6 сервисов требуют согласования с ТЗ 3–5"]
        GW["Nginx: HTTP, WebSocket Upgrade, /media cache; без распределённого CDN"]
        C["Catalog: товар, остаток, CatalogPage и SearchPreset/page_id; outbox"]
        A["Cart: до 10 вещей, без резерва; consumer доступности и outbox"]
        O["Order: оркестратор саги, тестовая оплата, outbox"]
        N["Notification: кому/что/когда; SignalR только WebSocket; ACK после commit"]
        AUTH["Auth: JWT, customer/admin, хеши"]
        I["Image: upload admin, metadata и GET изображения по ID"]
        CD[("catalog_db / PostgreSQL")]
        AD[("cart_db / PostgreSQL")]
        OD[("order_db / PostgreSQL")]
        ND[("notification_db / PostgreSQL")]
        AUTHDB[("auth_db / PostgreSQL")]
        IDB[("image_db / PostgreSQL")]
        R[("Redis: общая первая страница; TTL 60 с; без остатков")]
        S3[("Локальный S3 / SeaweedFS: файлы на volume")]
        OBS["OTel Collector → Loki / Tempo / Mimir → Grafana"]
        subgraph BROKER["RabbitMQ"]
            EX["Exchange: shop.events"]
            CQ["Queue: cart.availability"]
            NQ["Queue: notifications.events"]
            EX -.->|"catalog.availability_changed"| CQ
            EX -.->|"cart.item_added / item_availability_changed; order.reserved / confirmed / cancelled"| NQ
        end
        GW -->|"HTTP: каталог/admin и страницы/пресеты"| C
        GW -->|"HTTP: корзина"| A
        GW -->|"HTTP: заказ"| O
        GW -->|"HTTP: история"| N
        GW -->|"HTTP: register/login/me"| AUTH
        GW -->|"HTTP: /media cache → GET /images/id; upload admin"| I
        N -->|"WebSocket push"| GW
        A -->|"HTTP: live товары/наличие"| C
        O -->|"HTTP: cart / remove-items"| A
        O -->|"HTTP: reserve / complete / release"| C
        C -->|"HTTP: image metadata"| I
        C -->|SQL| CD
        A -->|SQL| AD
        O -->|SQL| OD
        N -->|SQL| ND
        AUTH -->|SQL| AUTHDB
        I -->|SQL| IDB
        C -->|"RESP: page=1; fallback на БД"| R
        I -->|"S3 API: файлы"| S3
        C -.->|"ProductAvailabilityChanged: version/status"| EX
        CQ -.->|"basicConsume push; version/dedup"| A
        A -.->|"CartItemAdded / CartItemAvailabilityChanged: user_id"| EX
        O -.->|"OrderReserved / OrderConfirmed / OrderCancelled"| EX
        NQ -.->|"basicConsume push"| N
        C -->|OTLP| OBS
        A -->|OTLP| OBS
        O -->|OTLP| OBS
        N -->|OTLP| OBS
        AUTH -->|OTLP| OBS
        I -->|OTLP| OBS
    end
    UI -->|"HTTP / JWT; JSON содержит image_url"| GW
    GW -->|"WebSocket без SSE/Long Polling"| UI
